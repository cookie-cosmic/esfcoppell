# --- Server ---
PORT=8080
NODE_ENV=production

# Where SQLite + uploads live (default: ./data)
# DATA_DIR=/var/data/endless-smiles
# DB_PATH=/var/data/endless-smiles/app.db
# UPLOAD_DIR=/var/data/endless-smiles/uploads

# --- Security ---
# Set to true when serving over HTTPS (adds Secure flag to cookies)
COOKIE_SECURE=false
# Origin allowed to call the API when the SPA is hosted separately.
# CLIENT_ORIGIN=https://esfcoppell.web.app
# Secret used to sign member-directory proof cookies (generate: openssl rand -base64 32)
MEMBER_COOKIE_SECRET=change-me-in-production

# --- Optional one-time bootstrap ---
# If set (and no admin exists yet), POST /api/admin/setup with this token creates the first OWNER.
# Prefer `npm run create-admin` on the host; never commit a token.
# ADMIN_SETUP_TOKEN=

# --- Client (build-time) ---
# Only needed when the SPA is hosted separately from the API (e.g. GitHub Pages):
# VITE_API_BASE=https://esfcoppell-api.onrender.com
